{
  "name": "tabernacle",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Organise your Firefox tabs with sidebar folders, nested tab trees and search.",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:ui": "node scripts/run-ui-tests.js",
    "test:audio": "node test/ui/test-audio-ui.js",
    "test:containers": "node test/ui/test-containers-ui.js",
    "test:color-mode": "node test/ui/test-color-mode-ui.js",
    "test:performance": "node test/ui/test-performance-ui.js",
    "benchmark:memory": "node scripts/benchmark-optimisation.js",
    "benchmark:memory:firefox": "node scripts/benchmark-optimisation.js",
    "test:firefox": "node scripts/run-firefox-tests.js",
    "test:stress": "node scripts/stress-firefox.js",
    "lint": "npm run lint:js && npm run lint:extension",
    "lint:js": "eslint . --max-warnings 0",
    "lint:extension": "node scripts/lint-extension.js",
    "build": "node scripts/build.js",
    "dev": "web-ext run --source-dir extension",
    "preview": "node scripts/preview.js",
    "screenshots:prepare": "node scripts/prepare-screenshots.js",
    "screenshots:refresh": "node scripts/refresh-screenshots.js",
    "format": "eslint . --fix && prettier --write .",
    "test:ui:core": "node test/ui/test-ui.js",
    "check": "npm run format:check && npm run lint && npm test",
    "format:check": "prettier --check .",
    "screenshots:export": "node scripts/export-screenshots.js",
    "icons:generate": "node scripts/generate-icons.js",
    "test:settings": "node test/ui/test-settings-ui.js",
    "test:new-tab": "node test/ui/test-new-tab-ui.js",
    "test:new-tab:firefox": "node test/firefox/test-new-tab-firefox.js",
    "test:backup": "node test/ui/test-backup-ui.js",
    "test:backup:firefox": "node test/firefox/test-backup-firefox.js",
    "test:neutral": "node test/ui/test-neutral-ui.js",
    "test:toolbar:firefox": "node test/firefox/test-toolbar-icon-firefox.js",
    "qa:release": "node scripts/release-qa.js",
    "benchmark:optim": "node scripts/benchmark-optimisation.js",
    "benchmark:report": "node scripts/benchmark-optimisation.js --report",
    "benchmark:memory:synthetic": "node scripts/benchmark-optimisation.js --synthetic-only",
    "benchmark:memory:stress": "node scripts/benchmark-memory.js --stress",
    "benchmark:memory:firefox:stress": "node scripts/benchmark-memory-firefox.js --stress --tabs 100 --windows 2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.11.0",
    "geckodriver": "7.0.0",
    "prettier": "3.9.9",
    "selenium-webdriver": "4.49.0",
    "sharp": "0.35.4",
    "web-ext": "10.7.0"
  },
  "license": "MIT",
  "author": {
    "name": "Michael Projects",
    "email": "tabernacle@michaelprojects.com",
    "url": "https://michaelprojects.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/micprojects/tabernacle.git"
  },
  "homepage": "https://michaelprojects.com/tabernacle/",
  "bugs": {
    "url": "https://github.com/micprojects/tabernacle/issues",
    "email": "tabernacle@michaelprojects.com"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
