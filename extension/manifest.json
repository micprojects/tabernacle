{
  "manifest_version": 3,
  "name": "Tabernacle",
  "version": "0.2.0",
  "description": "Organise your Firefox tabs with sidebar folders, nested tab trees and search.",
  "permissions": [
    "tabs",
    "storage",
    "search",
    "sessions",
    "tabGroups",
    "contextualIdentities",
    "cookies",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "http://*/*",
    "https://*/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*",
    "https://music.youtube.com/*",
    "https://*.reddit.com/*",
    "https://news.ycombinator.com/*",
    "https://hacker-news.firebaseio.com/*",
    "https://github.com/*",
    "https://*.amazon.com/*",
    "https://*.amazon.co.uk/*",
    "https://*.amazon.de/*",
    "https://*.amazon.fr/*",
    "https://*.amazon.it/*",
    "https://*.amazon.es/*",
    "https://*.amazon.ca/*",
    "https://*.amazon.com.au/*",
    "https://*.amazon.co.jp/*",
    "https://*.amazon.in/*",
    "https://*.amazon.nl/*",
    "https://*.amazon.se/*",
    "https://*.ebay.com/*",
    "https://*.ebay.co.uk/*",
    "https://*.ebay.de/*",
    "https://*.ebay.fr/*",
    "https://*.ebay.it/*",
    "https://*.ebay.es/*",
    "https://*.ebay.ca/*",
    "https://*.ebay.com.au/*",
    "https://*.etsy.com/*",
    "https://*.wikipedia.org/*",
    "https://*.google.com/*",
    "https://*.google.co.uk/*",
    "https://*.google.de/*",
    "https://*.google.fr/*",
    "https://*.google.it/*",
    "https://*.google.es/*",
    "https://*.google.ca/*",
    "https://*.google.com.au/*",
    "https://*.google.co.jp/*",
    "https://*.google.co.in/*",
    "https://*.imdb.com/*",
    "https://*.letterboxd.com/*"
  ],
  "incognito": "not_allowed",
  "browser_specific_settings": {
    "gecko": {
      "id": "tabernacle@michaelprojects.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["locationInfo"]
      }
    }
  },
  "background": {
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "sidebar_action": {
    "default_title": "Tabernacle",
    "default_panel": "sidebar.html",
    "default_icon": "icons/tabernacle-toolbar.svg",
    "open_at_install": true
  },
  "action": {
    "default_title": "Show/hide Tabernacle",
    "default_icon": "icons/tabernacle-toolbar.svg"
  },
  "icons": {
    "16": "icons/tabernacle.svg",
    "32": "icons/tabernacle.svg",
    "48": "icons/tabernacle.svg",
    "64": "icons/tabernacle.svg",
    "96": "icons/tabernacle.svg",
    "128": "icons/tabernacle.svg",
    "256": "icons/tabernacle.svg"
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Open or close Tabernacle"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' data: https: http: moz-extension: resource://usercontext-content/; connect-src https://www.youtube.com https://hacker-news.firebaseio.com https://api.open-meteo.com https://geocoding-api.open-meteo.com"
  },
  "author": "Michael Projects",
  "homepage_url": "https://michaelprojects.com/tabernacle/"
}
