{
  "manifest_version": 3,
  "name": "Tabernacle",
  "version": "0.1.7",
  "description": "Organise your Firefox tabs with sidebar folders, nested tab trees and search.",
  "permissions": [
    "tabs",
    "storage",
    "sessions",
    "tabGroups",
    "contextualIdentities",
    "cookies",
    "management"
  ],
  "incognito": "not_allowed",
  "browser_specific_settings": {
    "gecko": {
      "id": "tabernacle@michaelprojects.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "sidebar_action": {
    "default_title": "Tabernacle",
    "default_panel": "sidebar.html",
    "default_icon": "icons/tabernacle-toolbar.svg",
    "open_at_install": true
  },
  "action": {
    "default_title": "Show/hide Tabernacle",
    "default_icon": "icons/tabernacle-toolbar.svg"
  },
  "icons": {
    "16": "icons/tabernacle-16.png",
    "32": "icons/tabernacle-32.png",
    "48": "icons/tabernacle-48.png",
    "64": "icons/tabernacle-64.png",
    "96": "icons/tabernacle-96.png",
    "128": "icons/tabernacle-128.png",
    "256": "icons/tabernacle-256.png"
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Open or close Tabernacle"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' data: https: http: moz-extension: resource://usercontext-content/; connect-src 'none'"
  },
  "author": "Michael Projects",
  "homepage_url": "https://michaelprojects.com/tabernacle/"
}
